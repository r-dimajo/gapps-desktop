{
  "name": "gapps-desktop",
  "version": "1.2.0",
  "description": "GApps - unofficial desktop client for Google Workspace on Linux",
  "main": "main.js",
  "author": "Riccardo Di Majo <riccardo.dimajo@aitronik.com>",
  "license": "MIT",
  "homepage": "https://github.com/r-dimajo/gapps-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/r-dimajo/gapps-desktop.git"
  },
  "scripts": {
    "start": "electron . --no-sandbox",
    "start:gnome": "GTK_THEME=Adwaita:dark electron . --no-sandbox --gnome --new-instance",
    "install-desktop": "bash tools/install_desktop.sh",
    "build:deb": "electron-builder --linux deb",
    "build:appimage": "electron-builder --linux AppImage",
    "dist": "electron-builder --linux deb AppImage"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.rdimajo.gapps",
    "productName": "gapps",
    "executableName": "gapps",
    "artifactName": "${name}_${version}_${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "tab-preload.js",
      "apps.js",
      "svg-icons.js",
      "icons/**/*",
      "tabbar/**/*",
      "newtab/**/*",
      "package.json"
    ],
    "linux": {
      "maintainer": "Riccardo Di Majo <riccardo.dimajo@aitronik.com>",
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "icons/linux",
      "category": "Network;Office;Chat;",
      "synopsis": "Unofficial desktop client for Google Workspace",
      "description": "Unofficial desktop client for Google Workspace. Not affiliated with Google LLC.",
      "desktop": {
        "entry": {
          "Name": "GApps",
          "GenericName": "Google Workspace client",
          "Comment": "Unofficial desktop client for Google Workspace",
          "StartupWMClass": "gapps"
        }
      }
    },
    "deb": {
      "packageName": "gapps-desktop",
      "maintainer": "Riccardo Di Majo <riccardo.dimajo@aitronik.com>",
      "priority": "optional",
      "depends": [
        "libnotify4",
        "libnss3",
        "libsecret-1-0",
        "libasound2 | libasound2t64",
        "libgbm1"
      ],
      "desktop": {
        "entry": {
          "Name": "GApps",
          "GenericName": "Google Workspace client",
          "Comment": "Unofficial desktop client for Google Workspace",
          "StartupWMClass": "gapps"
        }
      },
      "fpm": [
        "--replaces=google-suite-linux",
        "--conflicts=google-suite-linux",
        "--provides=google-suite-linux"
      ]
    }
  },
  "desktopName": "gapps.desktop"
}
